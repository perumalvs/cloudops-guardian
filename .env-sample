# CloudOps Guardian — environment sample. Copy to .env and fill in. Never commit .env.
# Pre-filled values come from the frozen architecture doc. Fill in the blanks (<...>).

# ---- AWS access (use ONE method) ----
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=__ACCOUNT_ID__
# Method A: named profile (preferred, e.g. SSO)
AWS_PROFILE=<your-profile>
# Method B: temporary keys (leave blank if using a profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---- Core case foundation ----
CASE_TABLE_NAME=CloudOpsGuardian-CaseState
INCIDENT_WORKFLOW_NAME=CloudOpsGuardian-IncidentWorkflow
INCIDENT_WORKFLOW_ARN=arn:aws:states:us-east-1:__ACCOUNT_ID__:stateMachine:CloudOpsGuardian-IncidentWorkflow
INCIDENT_HANDLER_FUNCTION=CloudOpsGuardian-IncidentHandler
INCIDENT_RULE_NAME=CloudOpsGuardian-IncidentRule
DEMO_INSTANCE_ID=__DEMO_INSTANCE_ID__
REQUIRED_RESOURCE_TAG=AgentRemediation=Enabled
CPU_ALARM_NAME=CloudOpsGuardian-EC2CPUAlarm

# ---- Reasoning Runtime (preserve "cloudopsguardin" spelling) ----
REASONING_RUNTIME_NAME=hackathon_cloudopsguardin_runtime_agent
REASONING_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:__ACCOUNT_ID__:runtime/hackathon_cloudopsguardin_runtime_agent-__REASONING_RUNTIME_SUFFIX__
REASONING_RUNTIME_QUALIFIER=DEFAULT

# ---- READ path ----
READ_GATEWAY_NAME=hackathon-cloudopsguardian-gateway
READ_GATEWAY_TARGET=hackathon-cloudopsguardian-aws-read-tools
READ_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:__ACCOUNT_ID__:runtime/hackathon_cloudopsguardian_mcp_read_tools-__READ_RUNTIME_SUFFIX__
# Get from: aws bedrock-agentcore-control get-gateway --gateway-identifier <id>
READ_GATEWAY_ID=<fill-in>
READ_GATEWAY_MCP_URL=<https://...gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp>

# ---- ACTION path ----
ACTION_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:__ACCOUNT_ID__:runtime/cloudops_guardian_mcp_action_tools-__ACTION_RUNTIME_SUFFIX__
ACTION_ENDPOINT_ARN=arn:aws:bedrock-agentcore:us-east-1:__ACCOUNT_ID__:runtime/cloudops_guardian_mcp_action_tools-__ACTION_RUNTIME_SUFFIX__/runtime-endpoint/DEFAULT
ACTION_GATEWAY_NAME=hackathon-cloudopsguardian-action-tools-gateway
ACTION_GATEWAY_TARGET=CloudOpsGuardian-ACTION-Tools
ACTION_GATEWAY_ID=<fill-in>
ACTION_GATEWAY_MCP_URL=<https://...gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp>
POLICY_ENGINE_ARN=arn:aws:bedrock-agentcore:us-east-1:__ACCOUNT_ID__:policy-engine/cloudopsguardian_action_policy_engine-__POLICY_ENGINE_SUFFIX__

# ---- Gateway inbound auth (check get-gateway -> authorizerType: AWS_IAM or CUSTOM_JWT) ----
GATEWAY_AUTH_MODE=<AWS_IAM|CUSTOM_JWT>
# Only if CUSTOM_JWT:
GATEWAY_OAUTH_TOKEN_URL=
GATEWAY_OAUTH_CLIENT_ID=
GATEWAY_OAUTH_CLIENT_SECRET=
GATEWAY_OAUTH_SCOPE=

# ---- SES / inbound email ----
SES_REGION=us-east-1
SES_FROM_ADDRESS=__SES_FROM_ADDRESS__
SES_VERIFIED_DOMAIN=__SES_DOMAIN__
INBOUND_EMAIL_BUCKET=__INBOUND_BUCKET__
INBOUND_PROCESSOR_FUNCTION=CloudOpsGuardian-InboundEmailProcessor
# Receiving an incident email != permission to approve. Keep lists separate. Comma-separated.
CLOUDOPS_OPERATOR_EMAILS=<operator1@example.com,operator2@example.com>
CLOUDOPS_APPROVER_EMAILS=<approver@example.com>

# ---- Approval policy ----
APPROVAL_EXPIRY_MINUTES=30
# Hash pepper for approval tokens; generate: python -c "import secrets;print(secrets.token_hex(32))"
APPROVAL_TOKEN_PEPPER=<generate-random-hex>
REQUIRE_SES_AUTH_PASS=true

# ---- Orchestrator (new, created later) ----
ORCHESTRATOR_FUNCTION_NAME=CloudOpsGuardian-Orchestrator
LOG_LEVEL=INFO
