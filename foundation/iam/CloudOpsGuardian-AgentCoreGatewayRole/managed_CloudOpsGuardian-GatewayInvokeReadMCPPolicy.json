            "Action": [
                "bedrock-agentcore:InvokeAgentRuntime"
            ],
            "Resource": [
                "arn:aws:bedrock-agentcore:us-east-1:__ACCOUNT_ID__:runtime/hackathon_cloudopsguardian_mcp_read_tools-__READ_RUNTIME_SUFFIX__",
