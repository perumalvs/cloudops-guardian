# Values that render.py substitutes into the deploy scripts and IAM/Step Functions files.
# Copy to config.env and fill in. Never commit config.env.

ACCOUNT_ID=111122223333
DEMO_INSTANCE_ID=i-0123456789abcdef0      # EC2 instance tagged AgentRemediation=Enabled

# SES
SES_DOMAIN=example.com                     # verified SES domain (also receives inbound mail)
SES_FROM_ADDRESS=cloudops@example.com
INBOUND_BUCKET=my-cloudops-guardian-inbound-mail   # S3 bucket the SES receipt rule writes to

# People. Operators receive mail; approvers may approve. Use the same address twice if you only have one.
APPROVER_EMAIL=you@example.com
OPERATOR_EMAIL_2=colleague@example.com

# IDs assigned by AgentCore when you create the resources (the suffix after the last "-")
READ_GATEWAY_SUFFIX=
ACTION_GATEWAY_SUFFIX=
REASONING_RUNTIME_SUFFIX=
READ_RUNTIME_SUFFIX=
ACTION_RUNTIME_SUFFIX=
POLICY_ENGINE_SUFFIX=

# Bucket AgentCore created for runtime code: bedrock-agentcore-runtime-<account>-us-east-1-<suffix>
RUNTIME_BUCKET_SUFFIX=
READ_TARGET_ID=
